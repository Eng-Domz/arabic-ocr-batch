__pycache__/
*.py[cod]
*.egg-info/
.venv/
.coverage
.pytest_cache/
.mypy_cache/

# Local configuration and runtime data
config.toml
input/**
!input/.gitkeep
output/**
!output/searchable/
!output/searchable/.gitkeep
!output/text/
!output/text/.gitkeep
logs/**
!logs/.gitkeep
reports/**
!reports/.gitkeep
state/**
!state/.gitkeep
work/**
!work/.gitkeep
tmp/
models/
tests/fixtures/*.gt.txt
!tests/fixtures/.gitkeep

# Never publish source scans, rendered pages, OCR databases, or model weights.
*.pdf
*.png
*.tif
*.tiff
*.sqlite3
*.sqlite3-*
*.mlmodel
*.safetensors
*.alto.xml
*.log

